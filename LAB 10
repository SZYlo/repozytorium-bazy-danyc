DELIMITER $$

CREATE FUNCTION income_for_month(p_year INT, p_month INT)
RETURNS DECIMAL(10,2)
DETERMINISTIC
BEGIN
    RETURN (
        SELECT IFNULL(SUM(op.QUANTITY * op.PRICE), 0.00)
        FROM `ORDER` o
        JOIN ORDER_POSITION op ON o.ORDER_ID = op.ORDER_ID
        JOIN STATUS_NAME s ON o.STATUS_ID = s.STATUS_ID
        WHERE s.NAME = 'COMPLETED'
          AND YEAR(o.ORDER_DATE) = p_year
          AND MONTH(o.ORDER_DATE) = p_month
    );
END$$

DELIMITER ;


