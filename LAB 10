DELIMITER $$

CREATE TRIGGER trg_check_inventory
BEFORE INSERT ON ORDER_POSITION
FOR EACH ROW
BEGIN
    DECLARE available INT;

    SELECT AVAILABLE_QTY
    INTO available
    FROM INVENTORY
    WHERE PRODUCT_ID = NEW.PRODUCT_ID;

    IF available IS NULL OR available < NEW.QUANTITY THEN
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'Brak wystarczającej ilości produktu w magazynie';
    END IF;
END$$

DELIMITER ;

