CREATE TABLE ORDER_ARCHIVE LIKE `ORDER`;
CREATE TABLE ORDER_POSITION_ARCHIVE LIKE ORDER_POSITION;

#USWAM KLUCZE OBCE JESLI ISTNIEJA 

#______B_____

DELIMITER $$

CREATE PROCEDURE archive_order(IN p_order_id INT)
BEGIN
    DECLARE new_order_id INT;

    START TRANSACTION;

    INSERT INTO ORDER_ARCHIVE (ORDER_NUMBER, STATUS_ID, ORDER_DATE)
    SELECT ORDER_NUMBER, STATUS_ID, ORDER_DATE
    FROM `ORDER`
    WHERE ORDER_ID = p_order_id;

    SET new_order_id = LAST_INSERT_ID();

    INSERT INTO ORDER_POSITION_ARCHIVE (ORDER_ID, PRODUCT_ID, QUANTITY, PRICE)
    SELECT new_order_id, PRODUCT_ID, QUANTITY, PRICE
    FROM ORDER_POSITION
    WHERE ORDER_ID = p_order_id;

    DELETE FROM ORDER_POSITION WHERE ORDER_ID = p_order_id;
    DELETE FROM `ORDER` WHERE ORDER_ID = p_order_id;

    COMMIT;
END$$

DELIMITER ;


#______C_____

DELIMITER $$

CREATE TRIGGER trg_archive_order
BEFORE DELETE ON `ORDER`
FOR EACH ROW
BEGIN
    CALL archive_order(OLD.ORDER_ID);
END$$

DELIMITER ;

