DELIMITER $$

CREATE PROCEDURE product_find_by_phrase(IN p_phrase VARCHAR(255))
BEGIN
    SELECT *
    FROM PRODUCT
    WHERE NAME LIKE CONCAT('%', p_phrase, '%')
       OR DESCRIPTION LIKE CONCAT('%', p_phrase, '%');
END$$

DELIMITER ;


